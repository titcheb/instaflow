const BASE=fs.readFileSync(path.join(__dirname,'public','index.html'),'utf8');
const HTML=BASE.replace('</head>','<link rel="stylesheet" href="/admin.css" /></head>').replace('</body>','<script src="/admin.js" defer></script></body>');
app.use(express.json({limit:'30mb'}));
app.get('/',(req,res)=>res.type('html').send(HTML));
app.use(express.static(path.join(__dirname,'public'),{index:false,etag:true,maxAge:'5m'}));

const clean=(s,max=5000)=>String(s??'').trim().slice(0,max);
function next(s,k){const n=s.seq[k]||1;s.seq[k]=n+1;return n}
function tokenFor(u){return jwt.sign({uid:u.id,email:u.email},JWT_SECRET,{expiresIn:'14d'})}
function getAccountFromReq(req){const raw=req.headers.authorization||'';if(!raw.startsWith('Bearer '))return null;try{const c=jwt.verify(raw.slice(7),JWT_SECRET);const s=readStore();const u=s.users.find(x=>String(x.id)===String(c.uid));return u?{claims:c,user:u,store:s}:null}catch{return null}}
function requireAuth(req,res){const a=getAccountFromReq(req);if(!a){res.status(401).json({error:'Unauthorized'});return null}if(a.user.disabled){res.status(403).json({error:'This account has been suspended.'});return null}return a}
function requireAdmin(req,res){const a=requireAuth(req,res);if(!a)return null;if(a.user.role!=='admin'){res.status(403).json({error:'Admin access required.'});return null}return a}
function userSummary(s,u){const ps=s.playlists.filter(p=>String(p.user_id)===String(u.id)),pids=new Set(ps.map(p=>String(p.id)));return{id:u.id,email:u.email,role:u.role||'user',disabled:!!u.disabled,created_at:u.created_at,playlist_count:ps.length,channel_count:s.channels.filter(c=>pids.has(String(c.playlist_id))).length}}
function adminCount(s){return s.users.filter(u=>u.role==='admin'&&!u.disabled).length}

app.post('/api/auth/register',async(req,res)=>{const s=readStore(),email=clean(req.body.email,320).toLowerCase(),password=String(req.body.password||'');if(!/^\S+@\S+\.\S+$/.test(email)||password.length<8)return res.status(400).json({error:'Use a valid email and at least 8 characters for the password.'});if(s.users.some(u=>u.email===email))return res.status(409).json({error:'An account with this email already exists.'});const u={id:next(s,'user'),email,password_hash:await bcrypt.hash(password,12),role:s.users.length?'user':'admin',disabled:false,created_at:new Date().toISOString()};s.users.push(u);writeStore(s);restartChild();res.json({token:tokenFor(u),user:userSummary(s,u)})});
app.post('/api/auth/login',async(req,res)=>{const s=readStore(),email=clean(req.body.email,320).toLowerCase(),password=String(req.body.password||''),u=s.users.find(x=>x.email===email);if(!u||!await bcrypt.compare(password,u.password_hash))return res.status(401).json({error:'Wrong email or password.'});if(u.disabled)return res.status(403).json({error:'This account has been suspended.'});res.json({token:tokenFor(u),user:userSummary(s,u)})});
app.get('/api/me',(req,res)=>{const a=requireAuth(req,res);if(a)res.json(userSummary(a.store,a.user))});

app.get('/api/admin/stats',(req,res)=>{const a=requireAdmin(req,res);if(!a)return;const s=a.store;res.json({users:s.users.length,active_users:s.users.filter(u=>!u.disabled).length,playlists:s.playlists.length,channels:s.channels.length})});
app.get('/api/admin/users',(req,res)=>{const a=requireAdmin(req,res);if(a)res.json(a.store.users.map(u=>userSummary(a.store,u)).sort((x,y)=>(+x.id)-(+y.id)))});
app.post('/api/admin/users',async(req,res)=>{const a=requireAdmin(req,res);if(!a)return;const s=a.store,email=clean(req.body.email,320).toLowerCase(),password=String(req.body.password||''),role=req.body.role==='admin'?'admin':'user';if(!/^\S+@\S+\.\S+$/.test(email)||password.length<8)return res.status(400).json({error:'Use a valid email and at least 8 characters for the password.'});if(s.users.some(u=>u.email===email))return res.status(409).json({error:'An account with this email already exists.'});const u={id:next(s,'user'),email,password_hash:await bcrypt.hash(password,12),role,disabled:false,created_at:new Date().toISOString()};s.users.push(u);writeStore(s);restartChild();res.json(userSummary(s,u))});
app.patch('/api/admin/users/:id',(req,res)=>{const a=requireAdmin(req,res);if(!a)return;const s=a.store,u=s.users.find(x=>String(x.id)===String(req.params.id));if(!u)return res.status(404).json({error:'User not found.'});const self=String(u.id)===String(a.user.id);if(typeof req.body.disabled==='boolean'){if(self&&req.body.disabled)return res.status(400).json({error:'You cannot suspend your own admin account.'});if(u.role==='admin'&&req.body.disabled&&adminCount(s)<=1)return res.status(400).json({error:'At least one active admin is required.'});u.disabled=req.body.disabled}if(['admin','user'].includes(req.body.role)){if(self&&req.body.role!=='admin')return res.status(400).json({error:'You cannot demote your own admin account.'});if(u.role==='admin'&&req.body.role==='user'&&adminCount(s)<=1)return res.status(400).json({error:'At least one active admin is required.'});u.role=req.body.role}writeStore(s);restartChild();res.json(userSummary(s,u))});
app.post('/api/admin/users/:id/reset-password',async(req,res)=>{const a=requireAdmin(req,res);if(!a)return;const s=a.store,u=s.users.find(x=>String(x.id)===String(req.params.id)),password=String(req.body.password||'');if(!u)return res.status(404).json({error:'User not found.'});if(password.length<8)return res.status(400).json({error:'Password must contain at least 8 characters.'});u.password_hash=await bcrypt.hash(password,12);writeStore(s);restartChild();res.json({ok:true})});
app.delete('/api/admin/users/:id',(req,res)=>{const a=requireAdmin(req,res);if(!a)return;const s=a.store,u=s.users.find(x=>String(x.id)===String(req.params.id));if(!u)return res.status(404).json({error:'User not found.'});if(String(u.id)===String(a.user.id))return res.status(400).json({error:'You cannot delete your own admin account.'});if(u.role==='admin'&&adminCount(s)<=1)return res.status(400).json({error:'At least one active admin is required.'});const pids=new Set(s.playlists.filter(p=>String(p.user_id)===String(u.id)).map(p=>String(p.id)));s.channels=s.channels.filter(c=>!pids.has(String(c.playlist_id)));s.playlists=s.playlists.filter(p=>String(p.user_id)!==String(u.id));s.users=s.users.filter(x=>x!==u);writeStore(s);restartChild();res.json({ok:true})});
