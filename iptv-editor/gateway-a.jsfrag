import express from 'express';
import bcrypt from 'bcryptjs';
import jwt from 'jsonwebtoken';
import crypto from 'crypto';
import dns from 'dns/promises';
import net from 'net';
import fs from 'fs';
import path from 'path';
import http from 'http';
import https from 'https';
import { createInterface } from 'readline';
import { fileURLToPath } from 'url';
import { initStorage, readStoreSync, writeStoreSync, syncRemoteFromDisk, closeStorage } from './storage.js';

const __dirname=path.dirname(fileURLToPath(import.meta.url));
const app=express();
const PORT=Number(process.env.PORT||10000);
const CHILD_PORT=PORT+1;
const JWT_SECRET=process.env.JWT_SECRET||'nexa-editor-beta-'+crypto.createHash('sha256').update(process.env.RENDER_SERVICE_ID||'local').digest('hex');
const MAX=25*1024*1024;

await initStorage();

function readStore(){return readStoreSync()}
function writeStore(store){return writeStoreSync(store)}
function normalizeStore(){
  const s=readStore();
  let changed=false;
  if(!Array.isArray(s.users)){s.users=[];changed=true}
  if(!Array.isArray(s.playlists)){s.playlists=[];changed=true}
  if(!Array.isArray(s.channels)){s.channels=[];changed=true}
  if(!s.seq||typeof s.seq!=='object'){s.seq={};changed=true}
  let maxUser=0,maxPlaylist=0,maxChannel=0;
  for(const u of s.users){maxUser=Math.max(maxUser,+u.id||0);if(!u.role){u.role='user';changed=true}if(typeof u.disabled!=='boolean'){u.disabled=false;changed=true}}
  for(const p of s.playlists)maxPlaylist=Math.max(maxPlaylist,+p.id||0);
  for(const c of s.channels)maxChannel=Math.max(maxChannel,+c.id||0);
  const maxima={user:maxUser,playlist:maxPlaylist,channel:maxChannel};
  for(const k of Object.keys(maxima)){if(!s.seq[k]||s.seq[k]<=maxima[k]){s.seq[k]=maxima[k]+1;changed=true}}
  if(s.users.length&&!s.users.some(u=>u.role==='admin')){s.users.slice().sort((a,b)=>(+a.id)-(+b.id))[0].role='admin';changed=true}
  if(changed)writeStore(s);
}
// Legacy calls remain in older route fragments. In single-process mode they are intentional no-ops.
function restartChild(){}
async function stopChildForHeavyWork(){global.gc?.()}
normalizeStore();
process.on('SIGTERM',async()=>{await syncRemoteFromDisk().catch(()=>{});await closeStorage();process.exit(0)});
