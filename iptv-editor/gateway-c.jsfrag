function isPrivateIp(ip){if(!ip)return true;if(net.isIPv4(ip)){const p=ip.split('.').map(Number);return p[0]===10||p[0]===127||p[0]===0||(p[0]===169&&p[1]===254)||(p[0]===172&&p[1]>=16&&p[1]<=31)||(p[0]===192&&p[1]===168)||(p[0]===100&&p[1]>=64&&p[1]<=127)||p[0]>=224}const x=ip.toLowerCase();return x==='::1'||x==='::'||x.startsWith('fc')||x.startsWith('fd')||x.startsWith('fe80:')}
async function safeUrl(url){const u=new URL(url);if(!['http:','https:'].includes(u.protocol))throw new Error('Only HTTP/HTTPS URLs are supported');if(u.hostname==='localhost'||u.hostname.endsWith('.local'))throw new Error('Local URLs are not allowed');const addrs=await dns.lookup(u.hostname,{all:true});if(!addrs.length||addrs.some(a=>isPrivateIp(a.address)))throw new Error('Private/local hosts are not allowed');return u}
class UpstreamError extends Error{constructor(status){super(`Provider returned HTTP ${status}`);this.status=status}}
function getText(url,ua,depth=0){return new Promise(async(resolve,reject)=>{let u;try{u=await safeUrl(url)}catch(e){return reject(e)}if(depth>5)return reject(new Error('Too many redirects'));const lib=u.protocol==='https:'?https:http;const r=lib.request(u,{headers:{'User-Agent':ua,'Accept':'*/*','Connection':'close','Cache-Control':'no-cache'}},resp=>{const st=Number(resp.statusCode||0);if(st>=300&&st<400&&resp.headers.location){const n=new URL(resp.headers.location,u).href;resp.resume();return getText(n,ua,depth+1).then(resolve,reject)}if(st<200||st>=300){resp.resume();return reject(new UpstreamError(st||'unknown'))}const len=Number(resp.headers['content-length']||0);if(len>MAX){resp.destroy();return reject(new Error('Response is larger than 25 MB'))}let size=0;const chunks=[];resp.on('data',c=>{size+=c.length;if(size>MAX)return r.destroy(new Error('Response is larger than 25 MB'));chunks.push(c)});resp.on('end',()=>resolve(Buffer.concat(chunks).toString('utf8')))});r.setTimeout(25000,()=>r.destroy(new Error('Source request timed out.')));r.on('error',reject);r.end()})}
async function fetchCompat(url){let last;for(const ua of ['VLC/3.0.21 LibVLC/3.0.21','IPTVSmartersPlayer','Mozilla/5.0 (Linux; Android 14) AppleWebKit/537.36 Chrome/126 Mobile Safari/537.36']){try{return await getText(url,ua)}catch(e){last=e;if(!(e instanceof UpstreamError))break}}throw last}
async function fetchPlaylist(url){return fetchCompat(url)}
async function fetchJson(url){const txt=await fetchCompat(url);try{return JSON.parse(txt)}catch{throw new Error('Provider returned invalid Xtream API JSON.')}}

function validHttpUrl(v){try{return ['http:','https:'].includes(new URL(v).protocol)}catch{return false}}
function parseAttrs(line){const out={};const re=/([\w-]+)="([^"]*)"/g;let m;while((m=re.exec(line)))out[m[1].toLowerCase()]=m[2];return out}
function parseM3u(text){const lines=String(text||'').replace(/^\uFEFF/,'').split(/\r?\n/),channels=[];let meta=null,ua='',ref='';for(const raw of lines){const line=raw.trim();if(!line)continue;if(line.startsWith('#EXTINF')){const attrs=parseAttrs(line),comma=line.indexOf(',');meta={attrs,name:comma>=0?line.slice(comma+1).trim():attrs['tvg-name']||'Unnamed channel'};ua='';ref=''}else if(/^#EXTVLCOPT:http-user-agent=/i.test(line))ua=line.split('=').slice(1).join('=').trim();else if(/^#EXTVLCOPT:http-referrer=/i.test(line)||/^#EXTVLCOPT:http-referer=/i.test(line))ref=line.split('=').slice(1).join('=').trim();else if(meta&&!line.startsWith('#')){const a=meta.attrs,c={name:clean(meta.name,500),url:clean(line,5000),group_title:clean(a['group-title']||'Other',500),tvg_id:clean(a['tvg-id'],500),tvg_name:clean(a['tvg-name'],500),logo:clean(a['tvg-logo'],5000),user_agent:clean(ua,1000),referrer:clean(ref,5000),enabled:true};if(validHttpUrl(c.url))channels.push(c);meta=null}}return channels}
function escM3u(v=''){return String(v).replace(/\\/g,'\\\\').replace(/"/g,'\\"').replace(/[\r\n]/g,' ')}
function groupNamesFor(s,p){const actual=[...new Set(s.channels.filter(c=>String(c.playlist_id)===String(p.id)).map(c=>c.group_title||'Other'))];const saved=Array.isArray(p.category_order)?p.category_order.filter(g=>actual.includes(g)):[];return [...saved,...actual.filter(g=>!saved.includes(g)).sort((a,b)=>a.localeCompare(b))]}
function sortPlaylistChannels(s,p,enabledOnly=false){const order=groupNamesFor(s,p),rank=new Map(order.map((g,i)=>[g,i]));return s.channels.filter(c=>String(c.playlist_id)===String(p.id)&&(!enabledOnly||c.enabled)).sort((a,b)=>(rank.get(a.group_title||'Other')??999999)-(rank.get(b.group_title||'Other')??999999)||(Number(a.sort_order)||0)-(Number(b.sort_order)||0)||(Number(a.id)||0)-(Number(b.id)||0))}
function buildM3u(p,channels){let out='#EXTM3U'+(p.epg_url?` x-tvg-url="${escM3u(p.epg_url)}"`:'')+'\n';for(const c of channels){const attrs=[c.tvg_id?`tvg-id="${escM3u(c.tvg_id)}"`:'',c.tvg_name?`tvg-name="${escM3u(c.tvg_name)}"`:'',c.logo?`tvg-logo="${escM3u(c.logo)}"`:'',c.group_title?`group-title="${escM3u(c.group_title)}"`:''].filter(Boolean).join(' ');out+=`#EXTINF:-1 ${attrs},${String(c.name||'Unnamed').replace(/[\r\n]/g,' ')}\n`;if(c.user_agent)out+=`#EXTVLCOPT:http-user-agent=${String(c.user_agent).replace(/[\r\n]/g,' ')}\n`;if(c.referrer)out+=`#EXTVLCOPT:http-referrer=${String(c.referrer).replace(/[\r\n]/g,' ')}\n`;out+=c.url+'\n'}return out}

function normalizePanelBase(server){const u=new URL(server);u.search='';u.hash='';u.pathname=u.pathname.replace(/\/+$/,'');return u.href.replace(/\/$/,'')}
async function fetchXtreamData(server,username,password,output='ts'){
  const base=normalizePanelBase(server),user=clean(username,500),pass=String(password||'').trim();
  if(!user||!pass)throw new Error('Xtream username and password are required.');
  await safeUrl(base);
  const qs=`username=${encodeURIComponent(user)}&password=${encodeURIComponent(pass)}`;
  const account=await fetchJson(`${base}/player_api.php?${qs}`);
  if(account?.user_info&&String(account.user_info.auth)==='0')throw new Error('Xtream credentials were rejected by the provider.');
  const [catsRaw,streamsRaw]=await Promise.all([
    fetchJson(`${base}/player_api.php?${qs}&action=get_live_categories`),
    fetchJson(`${base}/player_api.php?${qs}&action=get_live_streams`)
  ]);
  const cats=Array.isArray(catsRaw)?catsRaw:[],streams=Array.isArray(streamsRaw)?streamsRaw:[];
  if(!streams.length)throw new Error('Xtream API returned no live channels.');
  const catMap=new Map(cats.map(c=>[String(c.category_id),clean(c.category_name||'Other',500)]));
  const ext=output==='m3u8'?'m3u8':'ts';
  const channels=streams.map((x,i)=>({
    name:clean(x.name||`Channel ${i+1}`,500),
    url:`${base}/live/${encodeURIComponent(user)}/${encodeURIComponent(pass)}/${encodeURIComponent(x.stream_id)}.${ext}`,
    group_title:catMap.get(String(x.category_id))||'Other',
    tvg_id:clean(x.epg_channel_id||'',500),
    tvg_name:clean(x.name||'',500),
    logo:clean(x.stream_icon||'',5000),
    user_agent:'',referrer:'',enabled:true
  }));
  const used=new Set(channels.map(c=>c.group_title));
  const categoryOrder=cats.map(c=>catMap.get(String(c.category_id))).filter((g,i,a)=>g&&used.has(g)&&a.indexOf(g)===i);
  for(const g of used)if(!categoryOrder.includes(g))categoryOrder.push(g);
  return {base,user,pass,output:ext,channels,categoryOrder};
}

function proxy(req,res,bodyOverride){const body=bodyOverride!==undefined?JSON.stringify(bodyOverride):(['GET','HEAD'].includes(req.method)?null:JSON.stringify(req.body||{}));const headers={...req.headers,host:`127.0.0.1:${CHILD_PORT}`};delete headers['content-length'];if(body)headers['content-length']=Buffer.byteLength(body);const p=http.request({hostname:'127.0.0.1',port:CHILD_PORT,path:req.originalUrl,method:req.method,headers},pr=>{res.status(pr.statusCode||502);for(const [k,v] of Object.entries(pr.headers))if(v!==undefined&&!['transfer-encoding','connection'].includes(k.toLowerCase()))res.setHeader(k,v);pr.pipe(res)});p.on('error',()=>res.status(502).json({error:'Editor backend is restarting. Try again in a moment.'}));if(body)p.write(body);p.end()}

app.post('/api/xtream/import',async(req,res)=>{
  const a=requireAuth(req,res);if(!a)return;
  try{
    const s=a.store,name=clean(req.body.name,200)||'Xtream playlist',server=clean(req.body.server,5000),username=clean(req.body.username,500),password=String(req.body.password||''),output=req.body.output==='m3u8'?'m3u8':'ts';
    const data=await fetchXtreamData(server,username,password,output);
    const epg=clean(req.body.epgUrl,5000)||`${data.base}/xmltv.php?username=${encodeURIComponent(data.user)}&password=${encodeURIComponent(data.pass)}`;
    const p={id:next(s,'playlist'),user_id:a.user.id,name,source_url:'',epg_url:epg,public_token:crypto.randomBytes(18).toString('hex'),source_type:'xtream',xtream:{server:data.base,username:data.user,password:data.pass,output:data.output},category_order:data.categoryOrder,created_at:new Date().toISOString(),updated_at:new Date().toISOString()};
    s.playlists.push(p);let order=0;for(const c of data.channels)s.channels.push({id:next(s,'channel'),playlist_id:p.id,...c,sort_order:order++,created_at:new Date().toISOString(),updated_at:new Date().toISOString()});
    writeStore(s);restartChild();res.json({...p,channel_count:data.channels.length,group_count:data.categoryOrder.length});
  }catch(e){if(e instanceof UpstreamError)return res.status(502).json({error:`Xtream provider returned HTTP ${e.status}. It may be blocking cloud/server access.`,upstreamStatus:e.status});res.status(502).json({error:e.message||'Could not import Xtream account.'})}
});

app.post('/api/playlists/:id/refresh',async(req,res)=>{const a=requireAuth(req,res);if(!a)return;const s=a.store,p=s.playlists.find(x=>String(x.id)===String(req.params.id)&&String(x.user_id)===String(a.user.id));if(!p)return res.status(404).json({error:'Playlist not found'});try{let fresh,catOrder;if(p.source_type==='xtream'&&p.xtream){const d=await fetchXtreamData(p.xtream.server,p.xtream.username,p.xtream.password,p.xtream.output);fresh=d.channels;catOrder=d.categoryOrder}else{if(!p.source_url)return res.status(400).json({error:'This playlist has no refresh source.'});fresh=parseM3u(await fetchPlaylist(p.source_url))}if(!fresh.length)return res.status(400).json({error:'No HTTP/HTTPS channels were found in the refreshed playlist.'});const old=s.channels.filter(c=>String(c.playlist_id)===String(p.id)),map=new Map(old.map(c=>[c.url,c]));s.channels=s.channels.filter(c=>String(c.playlist_id)!==String(p.id));let order=0;for(const c of fresh){const o=map.get(c.url);s.channels.push({id:next(s,'channel'),playlist_id:p.id,name:o?.name||c.name,url:c.url,group_title:o?.group_title||c.group_title,tvg_id:o?.tvg_id||c.tvg_id,tvg_name:o?.tvg_name||c.tvg_name,logo:o?.logo||c.logo,user_agent:o?.user_agent||c.user_agent,referrer:o?.referrer||c.referrer,enabled:o?.enabled??true,sort_order:order++,created_at:new Date().toISOString(),updated_at:new Date().toISOString()})}if(catOrder){const existing=Array.isArray(p.category_order)?p.category_order:[];p.category_order=[...existing.filter(g=>catOrder.includes(g)),...catOrder.filter(g=>!existing.includes(g))]}p.updated_at=new Date().toISOString();writeStore(s);restartChild();res.json({ok:true,count:fresh.length})}catch(e){if(e instanceof UpstreamError)return res.status(502).json({error:`The IPTV provider returned HTTP ${e.status} to the cloud refresher.`,upstreamStatus:e.status});res.status(502).json({error:e.message||'Could not refresh source.'})}});

app.post('/api/playlists/:id/groups/reorder',(req,res)=>{const a=requireAuth(req,res);if(!a)return;const s=a.store,p=s.playlists.find(x=>String(x.id)===String(req.params.id)&&String(x.user_id)===String(a.user.id));if(!p)return res.status(404).json({error:'Playlist not found'});const actual=[...new Set(s.channels.filter(c=>String(c.playlist_id)===String(p.id)).map(c=>c.group_title||'Other'))],incoming=Array.isArray(req.body.groups)?req.body.groups.map(g=>clean(g,500)).filter(Boolean):[],unique=[];for(const g of incoming)if(actual.includes(g)&&!unique.includes(g))unique.push(g);for(const g of actual)if(!unique.includes(g))unique.push(g);p.category_order=unique;p.updated_at=new Date().toISOString();writeStore(s);restartChild();res.json({ok:true,groups:unique})});

app.post('/api/playlists/:id/groups/rename',(req,res)=>{const a=requireAuth(req,res);if(!a)return;const s=a.store,p=s.playlists.find(x=>String(x.id)===String(req.params.id)&&String(x.user_id)===String(a.user.id));if(!p)return res.status(404).json({error:'Playlist not found'});const from=clean(req.body.from,500),to=clean(req.body.to,500)||'Other';let count=0;for(const c of s.channels)if(String(c.playlist_id)===String(p.id)&&(c.group_title||'Other')===from){c.group_title=to;c.updated_at=new Date().toISOString();count++}const order=Array.isArray(p.category_order)?p.category_order:groupNamesFor(s,p);p.category_order=[...new Set(order.map(g=>g===from?to:g))];p.updated_at=new Date().toISOString();writeStore(s);restartChild();res.json({ok:true,count,groups:p.category_order})});

app.post('/api/playlists',async(req,res)=>{const a=requireAuth(req,res);if(!a)return;try{const body={...req.body};if(!body.m3uText&&body.sourceUrl)body.m3uText=await fetchPlaylist(clean(body.sourceUrl,5000));proxy(req,res,body)}catch(e){if(e instanceof UpstreamError)return res.status(502).json({error:`The IPTV provider returned HTTP ${e.status} to the cloud importer. Upload or paste the M3U file instead.`,upstreamStatus:e.status});res.status(502).json({error:e.message||'Could not import source URL.'})}});

app.get('/p/:token.m3u',(req,res)=>{const s=readStore(),p=s.playlists.find(x=>x.public_token===req.params.token);if(!p)return res.status(404).send('Playlist not found');const channels=sortPlaylistChannels(s,p,true);res.set({'Content-Type':'application/x-mpegURL; charset=utf-8','Content-Disposition':`inline; filename="${String(p.name||'playlist').replace(/[^a-z0-9_-]+/gi,'_')}.m3u"`,'Cache-Control':'no-store'}).send(buildM3u(p,channels))});
app.get('/p/:token.json',(req,res)=>{const s=readStore(),p=s.playlists.find(x=>x.public_token===req.params.token);if(!p)return res.status(404).json({error:'Playlist not found'});res.json({playlist:{id:p.id,name:p.name,epg_url:p.epg_url,category_order:groupNamesFor(s,p)},channels:sortPlaylistChannels(s,p,true).map(({name,url,group_title,tvg_id,tvg_name,logo,user_agent,referrer})=>({name,url,group_title,tvg_id,tvg_name,logo,user_agent,referrer}))})});

app.use('/api',(req,res)=>{const a=requireAuth(req,res);if(a)proxy(req,res)});
app.use('/p',(req,res)=>proxy(req,res));
app.get('/health',(req,res)=>res.json({ok:true,gateway:true,childPort:CHILD_PORT}));
app.get('*',(req,res)=>res.type('html').send(HTML));
app.listen(PORT,()=>console.log(`NEXA gateway listening on ${PORT}, editor child on ${CHILD_PORT}`));
