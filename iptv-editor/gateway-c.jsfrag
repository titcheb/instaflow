function isPrivateIp(ip){if(!ip)return true;if(net.isIPv4(ip)){const p=ip.split('.').map(Number);return p[0]===10||p[0]===127||p[0]===0||(p[0]===169&&p[1]===254)||(p[0]===172&&p[1]>=16&&p[1]<=31)||(p[0]===192&&p[1]===168)||(p[0]===100&&p[1]>=64&&p[1]<=127)||p[0]>=224}const x=ip.toLowerCase();return x==='::1'||x==='::'||x.startsWith('fc')||x.startsWith('fd')||x.startsWith('fe80:')}
async function safeUrl(url){const u=new URL(url);if(!['http:','https:'].includes(u.protocol))throw new Error('Only HTTP/HTTPS URLs are supported');const addrs=await dns.lookup(u.hostname,{all:true});if(!addrs.length||addrs.some(a=>isPrivateIp(a.address)))throw new Error('Private/local hosts are not allowed');return u}
class UpstreamError extends Error{constructor(status){super(`Provider returned HTTP ${status}`);this.status=status}}
function getText(url,ua,depth=0){return new Promise(async(resolve,reject)=>{let u;try{u=await safeUrl(url)}catch(e){return reject(e)}if(depth>5)return reject(new Error('Too many redirects'));const lib=u.protocol==='https:'?https:http;const r=lib.request(u,{headers:{'User-Agent':ua,'Accept':'*/*','Connection':'close','Cache-Control':'no-cache'}},resp=>{const st=Number(resp.statusCode||0);if(st>=300&&st<400&&resp.headers.location){const n=new URL(resp.headers.location,u).href;resp.resume();return getText(n,ua,depth+1).then(resolve,reject)}if(st<200||st>=300){resp.resume();return reject(new UpstreamError(st||'unknown'))}const len=Number(resp.headers['content-length']||0);if(len>MAX){resp.destroy();return reject(new Error('Playlist is larger than 25 MB'))}let size=0;const chunks=[];resp.on('data',c=>{size+=c.length;if(size>MAX)return r.destroy(new Error('Playlist is larger than 25 MB'));chunks.push(c)});resp.on('end',()=>resolve(Buffer.concat(chunks).toString('utf8')))});r.setTimeout(20000,()=>r.destroy(new Error('Source request timed out.')));r.on('error',reject);r.end()})}
async function fetchPlaylist(url){let last;for(const ua of ['VLC/3.0.21 LibVLC/3.0.21','Mozilla/5.0 (Linux; Android 14) AppleWebKit/537.36 Chrome/126 Mobile Safari/537.36']){try{return await getText(url,ua)}catch(e){last=e;if(!(e instanceof UpstreamError))break}}throw last}

function validHttpUrl(v){try{return ['http:','https:'].includes(new URL(v).protocol)}catch{return false}}
function parseAttrs(line){const out={};const re=/([\w-]+)="([^"]*)"/g;let m;while((m=re.exec(line)))out[m[1].toLowerCase()]=m[2];return out}
function parseM3u(text){const lines=String(text||'').replace(/^\uFEFF/,'').split(/\r?\n/),channels=[];let meta=null,ua='',ref='';for(const raw of lines){const line=raw.trim();if(!line)continue;if(line.startsWith('#EXTINF')){const attrs=parseAttrs(line),comma=line.indexOf(',');meta={attrs,name:comma>=0?line.slice(comma+1).trim():attrs['tvg-name']||'Unnamed channel'};ua='';ref=''}else if(/^#EXTVLCOPT:http-user-agent=/i.test(line))ua=line.split('=').slice(1).join('=').trim();else if(/^#EXTVLCOPT:http-referrer=/i.test(line)||/^#EXTVLCOPT:http-referer=/i.test(line))ref=line.split('=').slice(1).join('=').trim();else if(meta&&!line.startsWith('#')){const a=meta.attrs,c={name:clean(meta.name,500),url:clean(line,5000),group_title:clean(a['group-title']||'Other',500),tvg_id:clean(a['tvg-id'],500),tvg_name:clean(a['tvg-name'],500),logo:clean(a['tvg-logo'],5000),user_agent:clean(ua,1000),referrer:clean(ref,5000),enabled:true};if(validHttpUrl(c.url))channels.push(c);meta=null}}return channels}

function proxy(req,res,bodyOverride){const body=bodyOverride!==undefined?JSON.stringify(bodyOverride):(['GET','HEAD'].includes(req.method)?null:JSON.stringify(req.body||{}));const headers={...req.headers,host:`127.0.0.1:${CHILD_PORT}`};delete headers['content-length'];if(body)headers['content-length']=Buffer.byteLength(body);const p=http.request({hostname:'127.0.0.1',port:CHILD_PORT,path:req.originalUrl,method:req.method,headers},pr=>{res.status(pr.statusCode||502);for(const [k,v] of Object.entries(pr.headers))if(v!==undefined&&!['transfer-encoding','connection'].includes(k.toLowerCase()))res.setHeader(k,v);pr.pipe(res)});p.on('error',e=>res.status(502).json({error:'Editor backend is restarting. Try again in a moment.'}));if(body)p.write(body);p.end()}

app.post('/api/playlists/:id/refresh',async(req,res)=>{const a=requireAuth(req,res);if(!a)return;const s=a.store,p=s.playlists.find(x=>String(x.id)===String(req.params.id)&&String(x.user_id)===String(a.user.id));if(!p)return res.status(404).json({error:'Playlist not found'});if(!p.source_url)return res.status(400).json({error:'This playlist has no source URL.'});try{const fresh=parseM3u(await fetchPlaylist(p.source_url));if(!fresh.length)return res.status(400).json({error:'No HTTP/HTTPS channels were found in the refreshed playlist.'});const old=s.channels.filter(c=>String(c.playlist_id)===String(p.id)),map=new Map(old.map(c=>[c.url,c]));s.channels=s.channels.filter(c=>String(c.playlist_id)!==String(p.id));let order=0;for(const c of fresh){const o=map.get(c.url);s.channels.push({id:next(s,'channel'),playlist_id:p.id,name:o?.name||c.name,url:c.url,group_title:o?.group_title||c.group_title,tvg_id:o?.tvg_id||c.tvg_id,tvg_name:o?.tvg_name||c.tvg_name,logo:o?.logo||c.logo,user_agent:o?.user_agent||c.user_agent,referrer:o?.referrer||c.referrer,enabled:o?.enabled??true,sort_order:order++,created_at:new Date().toISOString(),updated_at:new Date().toISOString()})}p.updated_at=new Date().toISOString();writeStore(s);restartChild();res.json({ok:true,count:fresh.length})}catch(e){if(e instanceof UpstreamError)return res.status(502).json({error:`The IPTV provider returned HTTP ${e.status} to the cloud refresher. Upload/paste a fresh M3U instead.`,upstreamStatus:e.status});res.status(502).json({error:e.message||'Could not refresh source URL.'})}});

app.post('/api/playlists',async(req,res)=>{const a=requireAuth(req,res);if(!a)return;try{const body={...req.body};if(!body.m3uText&&body.sourceUrl)body.m3uText=await fetchPlaylist(clean(body.sourceUrl,5000));proxy(req,res,body)}catch(e){if(e instanceof UpstreamError)return res.status(502).json({error:`The IPTV provider returned HTTP ${e.status} to the cloud importer. Upload or paste the M3U file instead.`,upstreamStatus:e.status});res.status(502).json({error:e.message||'Could not import source URL.'})}});

app.use('/api',(req,res)=>{const a=requireAuth(req,res);if(a)proxy(req,res)});
app.use('/p',(req,res)=>proxy(req,res));
app.get('/health',(req,res)=>res.json({ok:true,gateway:true,childPort:CHILD_PORT}));
app.get('*',(req,res)=>res.type('html').send(HTML));
app.listen(PORT,()=>console.log(`NEXA gateway listening on ${PORT}, editor child on ${CHILD_PORT}`));
